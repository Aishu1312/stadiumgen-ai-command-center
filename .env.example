# ==========================
# APPLICATION
# ==========================
APP_NAME="StadiumGen AI Command Center"
APP_ENV="development"
APP_DEBUG="True"
APP_HOST="0.0.0.0"
APP_PORT="8501"

# ==========================
# SECURITY
# ==========================
SECRET_KEY="your_secret_key_here"
JWT_SECRET_KEY="your_jwt_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# ==========================
# GROQ AI
# ==========================
GROQ_API_KEY="your_groq_api_key"

# ==========================
# DATABASE
# ==========================
DATABASE_URL="sqlite:///stadiumgen.db"

# ==========================
# STREAMLIT
# ==========================
STREAMLIT_SERVER_PORT="8501"
STREAMLIT_SERVER_HEADLESS="true"

# ==========================
# LOGGING
# ==========================
LOG_LEVEL="INFO"

# ==========================
# CACHE
# ==========================
CACHE_TTL="3600"
